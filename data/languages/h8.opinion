    <constraint primary="46" processor="H8S" endian="big" size="32" variant="advanced" secondary="0b.... .... 1000 0010 .... .... .... ...."/>
    <constraint primary="46" processor="H8/300H" endian="big" size="32" variant="normal" secondary="0b.... .... 1000 0011 .... .... .... ...."/>
    <constraint primary="46" processor="H8S" endian="big" size="32" variant="normal" secondary="0b.... .... 1000 0100 .... .... .... ...."/>
    <constraint primary="46" processor="H8SX" endian="big" size="32" variant="advanced" secondary="0b.... .... 1000 0101 .... .... .... ...."/>
    <constraint primary="46" processor="H8SX" endian="big" size="32" variant="normal" secondary="0b.... .... 1000 0110 .... .... .... ...."/>
  </constraint>
</opinions>
